rules_version = '2';
// GENERATED by scripts/gen-rules.mjs. Do not edit by hand.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [];
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function validSeverity(v) {
      return v is int && v >= 0 && v <= 4;
    }

    function validItem(v) {
      return v is map
        && v.keys().hasOnly(['severity', 'unclear', 'comment'])
        && v.keys().hasAll(['severity', 'unclear', 'comment'])
        && v.unclear is bool
        && ((v.unclear == true && v.severity == null) || (v.unclear == false && validSeverity(v.severity)))
        && str(v.comment, 0, 1000);
    }

    function validItems(m) {
      return m is map
        && m.keys().hasOnly(["H1.1","H1.2","H1.3","H1.4","H2.1","H2.2","H2.3","H2.4","H3.1","H3.2","H3.3","H3.4","H4.1","H4.2","H4.3","H4.4","H5.1","H5.2","H5.3","H5.4"])
        && m.keys().hasAll(["H1.1","H1.2","H1.3","H1.4","H2.1","H2.2","H2.3","H2.4","H3.1","H3.2","H3.3","H3.4","H4.1","H4.2","H4.3","H4.4","H5.1","H5.2","H5.3","H5.4"])
        && validItem(m["H1.1"])
        && validItem(m["H1.2"])
        && validItem(m["H1.3"])
        && validItem(m["H1.4"])
        && validItem(m["H2.1"])
        && validItem(m["H2.2"])
        && validItem(m["H2.3"])
        && validItem(m["H2.4"])
        && validItem(m["H3.1"])
        && validItem(m["H3.2"])
        && validItem(m["H3.3"])
        && validItem(m["H3.4"])
        && validItem(m["H4.1"])
        && validItem(m["H4.2"])
        && validItem(m["H4.3"])
        && validItem(m["H4.4"])
        && validItem(m["H5.1"])
        && validItem(m["H5.2"])
        && validItem(m["H5.3"])
        && validItem(m["H5.4"]);
    }

    function validIssue(v) {
      return v is map
        && v.keys().hasOnly(['text', 'tag', 'severity'])
        && v.keys().hasAll(['text', 'tag', 'severity'])
        && str(v.text, 1, 2000)
        && v.tag in ['Verifying spatial output', 'Describing spatial relations', 'Tracking edits', 'Other']
        && validSeverity(v.severity);
    }

    function validIssues(o) {
      return o is list && o.size() <= 30
        && (o.size() <= 0 || validIssue(o[0]))
        && (o.size() <= 1 || validIssue(o[1]))
        && (o.size() <= 2 || validIssue(o[2]))
        && (o.size() <= 3 || validIssue(o[3]))
        && (o.size() <= 4 || validIssue(o[4]))
        && (o.size() <= 5 || validIssue(o[5]))
        && (o.size() <= 6 || validIssue(o[6]))
        && (o.size() <= 7 || validIssue(o[7]))
        && (o.size() <= 8 || validIssue(o[8]))
        && (o.size() <= 9 || validIssue(o[9]))
        && (o.size() <= 10 || validIssue(o[10]))
        && (o.size() <= 11 || validIssue(o[11]))
        && (o.size() <= 12 || validIssue(o[12]))
        && (o.size() <= 13 || validIssue(o[13]))
        && (o.size() <= 14 || validIssue(o[14]))
        && (o.size() <= 15 || validIssue(o[15]))
        && (o.size() <= 16 || validIssue(o[16]))
        && (o.size() <= 17 || validIssue(o[17]))
        && (o.size() <= 18 || validIssue(o[18]))
        && (o.size() <= 19 || validIssue(o[19]))
        && (o.size() <= 20 || validIssue(o[20]))
        && (o.size() <= 21 || validIssue(o[21]))
        && (o.size() <= 22 || validIssue(o[22]))
        && (o.size() <= 23 || validIssue(o[23]))
        && (o.size() <= 24 || validIssue(o[24]))
        && (o.size() <= 25 || validIssue(o[25]))
        && (o.size() <= 26 || validIssue(o[26]))
        && (o.size() <= 27 || validIssue(o[27]))
        && (o.size() <= 28 || validIssue(o[28]))
        && (o.size() <= 29 || validIssue(o[29]));
    }

    function validSession(d) {
      return d.keys().hasOnly(['schemaVersion', 'uid', 'auditor', 'group', 'condition', 'screenReader', 'items', 'outside', 'verification', 'submittedAt'])
        && d.keys().hasAll(['schemaVersion', 'uid', 'auditor', 'group', 'condition', 'screenReader', 'items', 'outside', 'verification', 'submittedAt'])
        && d.schemaVersion == 1
        && d.uid == request.auth.uid
        && str(d.auditor, 1, 40)
        && d.group in ['Sighted pilot (blindfolded)', 'BLV screen-reader user']
        && d.condition in ['A: OpenSCAD + ChatGPT', 'B: OpenSCAD + Claude']
        && str(d.screenReader, 1, 100)
        && d.submittedAt == request.time
        && d.verification is map
        && d.verification.keys().hasOnly(['answer', 'reason'])
        && d.verification.keys().hasAll(['answer', 'reason'])
        && d.verification.answer in ['Correct', 'Incorrect', 'Could not tell']
        && str(d.verification.reason, 0, 2000)
        && validItems(d.items)
        && validIssues(d.outside);
    }

    match /sessions/{sessionId} {
      allow create: if request.auth != null && validSession(request.resource.data);
      allow read: if isAdmin();   // covers get and list
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
