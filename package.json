  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "rules": "node scripts/gen-rules.mjs",
    "build": "npm run rules && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --port 4173",
