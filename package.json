    "test:live": "E2E_URL=https://hci-a11y-audit-edc867.web.app playwright test e2e-live",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.64.0-alpha-1790635538000",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-tools": "^15.34.1",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
